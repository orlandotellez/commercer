{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                u.id,\n                u.name,\n                u.email,\n                u.created_at,\n                a.password\n            FROM account a\n            JOIN users u ON u.id = a.user_id\n            WHERE a.account_id = $1\n            AND a.provider_id = 'credentials'\n            ",

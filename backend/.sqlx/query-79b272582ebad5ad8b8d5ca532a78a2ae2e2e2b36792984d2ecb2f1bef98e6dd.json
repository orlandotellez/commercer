  "query": "\n            SELECT \n                id::text as id,\n                name,\n                email,\n                email_verified,\n                COALESCE(role, 'customer') as role,\n                created_at::text as created_at\n            FROM users\n            ORDER BY created_at DESC\n            LIMIT $1 OFFSET $2\n            ",

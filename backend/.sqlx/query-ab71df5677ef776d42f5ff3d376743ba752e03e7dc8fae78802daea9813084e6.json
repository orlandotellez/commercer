{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id::text as \"id\", \n                name, \n                slug, \n                description, \n                price as \"price\", \n                COALESCE(original_price, 0.0) as \"original_price: Option<f64>\", \n                image_url as \"image\", \n                category_id::text as \"category_id\", \n                brand, \n                stock as \"stock\", \n                specs, \n                COALESCE(active, false) as \"active\", \n                COALESCE(featured, false) as \"featured\", \n                created_at::text as \"created_at\"\n            FROM product\n            WHERE id = $1\n            ",
